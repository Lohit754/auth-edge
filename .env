# Environment
NODE_ENV=development

# Server
PORT=4000

# Database
DATABASE_URL=file:./dev.db

# JWT Secrets (THESE ARE FOR DEVELOPMENT ONLY - REPLACE IN PRODUCTION)
ACCESS_TOKEN_SECRET=dev-access-token-secret-replace-with-long-random-string-32-chars-minimum
REFRESH_TOKEN_SECRET=dev-refresh-token-secret-replace-with-long-random-string-32-chars-minimum

# JWT TTL
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# CORS
CORS_ORIGIN=http://localhost:5173
